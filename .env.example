# Copy to .env and replace these values when using your own PostgreSQL database.
# Alternatively, npm run db:start creates an isolated local database and .env.
# Never prefix database credentials or authentication secrets with NEXT_PUBLIC_.
DATABASE_URL="postgresql://school_safe_ai:replace_with_your_password@127.0.0.1:55432/school_safe_ai"

# Required in production. Replace both placeholders with independent secrets.
# Development can omit them and use the demo access code shown on /login.
STAFF_ACCESS_CODE="replace-with-a-long-random-staff-access-code"
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
